{
  "name": "regina-system",
  "version": "2.0.0",
  "description": "Sistema de gestao de cargas, carregamentos, agendamentos e avarias",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "gmail:oauth-setup": "node --env-file-if-exists=.env src/scripts/gmail-oauth-setup.mjs",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/output.css --watch"
  },
  "dependencies": {
    "express": "^5.0.1",
    "fast-xml-parser": "^5.10.1",
    "googleapis": "^174.0.1",
    "multer": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^3.4.14",
    "xlsx": "^0.18.5"
  }
}
