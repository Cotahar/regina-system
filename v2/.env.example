PORT=3000
NODE_ENV=development
SESSION_SECRET=troque-por-uma-string-aleatoria-longa-em-producao

# Opcional: caminhos de armazenamento persistente (usado em producao com volume montado)
# DATABASE_PATH=/data/cargas.db
# UPLOADS_DIR=/data/uploads

# Notas Fiscais - importacao automatica via Gmail (OAuth, nunca senha).
# Client id/secret vem do Google Cloud Console (credencial OAuth tipo "Desktop app").
# Refresh token e gerado uma unica vez rodando: npm run gmail:oauth-setup
# Sem essas 3 variaveis, a importacao automatica fica desligada e o resto do sistema funciona normal.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_POLL_INTERVAL_MS=180000

# Romaneios da fabrica (e-mails "NOTIF TRANSPORTADOR" / "NOTIFICACAO TRANSPORTADOR"):
# usa as mesmas credenciais do Gmail acima, so LE a caixa (nao marca como lido).
# A leitura so importa e-mails recebidos a partir do momento em que foi ativada (o marco fica
# gravado no banco na primeira subida com o Gmail configurado). Para importar tambem um periodo
# anterior, informe quantos dias recuar (opcional - o padrao e nao puxar historico):
# ROMANEIO_DIAS_RETROATIVOS=0
# Trecho do nome da transportadora que identifica as cargas que sao nossas:
# ROMANEIO_TRANSPORTADORA=NUNES
# Remetentes aceitos (separados por virgula) - quem encaminha os avisos da fabrica. Outros sao ignorados:
# ROMANEIO_REMETENTES=contato@bnuneslogistica.com.br
