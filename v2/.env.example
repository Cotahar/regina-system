PORT=3000
NODE_ENV=development
SESSION_SECRET=troque-por-uma-string-aleatoria-longa-em-producao

# Opcional: caminhos de armazenamento persistente (usado em producao com volume montado)
# DATABASE_PATH=/data/cargas.db
# UPLOADS_DIR=/data/uploads

# Notas Fiscais - importacao automatica via Gmail (OAuth, nunca senha).
# Client id/secret vem do Google Cloud Console (credencial OAuth tipo "Desktop app").
# Refresh token e gerado uma unica vez rodando: npm run gmail:oauth-setup
# Sem essas 3 variaveis, a importacao automatica fica desligada e o resto do sistema funciona normal.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_POLL_INTERVAL_MS=180000
